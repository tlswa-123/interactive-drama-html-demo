/* ===== 视频详情页 - 暖色调 ===== */
.detail-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #FFF8F3;
}

.detail-video-wrap {
  width: 100%;
  height: 56vw;
  position: relative;
  flex-shrink: 0;
  background: #000;
}

.detail-video { width: 100%; height: 100%; }

/* 下方滚动区 */
.detail-scroll {
  flex: 1;
  height: 0;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3D2C29;
  line-height: 1.5;
  padding: 24rpx 30rpx 0;
  display: block;
}

.detail-desc {
  font-size: 24rpx;
  color: #8B7355;
  padding: 8rpx 30rpx 20rpx;
  display: block;
  line-height: 1.5;
}

/* 作者栏 */
.author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx 24rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}

.author-left { display: flex; align-items: center; gap: 16rpx; }

.author-avatar-lg {
  width: 72rpx; height: 72rpx; border-radius: 50%;
  border: 3rpx solid transparent;
  background-image: linear-gradient(#fff,#fff) padding-box,
                    linear-gradient(135deg, #F97316, #EC4899) border-box;
}

.author-name-lg { font-size: 28rpx; font-weight: 500; color: #3D2C29; }

.follow-btn-sm {
  padding: 10rpx 32rpx;
  background: linear-gradient(135deg, #F97316, #EC4899);
  color: #fff; font-size: 24rpx; border-radius: 32rpx; border: none;
  box-shadow: 0 4rpx 12rpx rgba(249,115,22,0.3);
}

/* 互动栏 */
.interaction-row {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  gap: 20rpx;
}

.interaction-item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx; border-radius: 32rpx;
  background: rgba(0,0,0,0.04);
  transition: all 0.15s ease;
}

.interaction-item:active { transform: scale(0.95); }
.interaction-item.liked { background: rgba(244,63,94,0.1); }

.interaction-icon-img { width: 32rpx; height: 32rpx; }
.interaction-count { font-size: 24rpx; color: #8B7355; }
.interaction-item.liked .interaction-count { color: #F43F5E; }

/* Tab 切换 */
.detail-tabs {
  display: flex;
  padding: 0 30rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
  gap: 40rpx;
}

.detail-tab {
  font-size: 28rpx;
  color: #8B7355;
  padding: 16rpx 0;
  position: relative;
}

.detail-tab.active {
  color: #F97316;
  font-weight: 600;
}

.detail-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0; left: 50%; transform: translateX(-50%);
  width: 36rpx; height: 6rpx; border-radius: 3rpx;
  background: linear-gradient(135deg, #F97316, #EC4899);
}

/* 内容区 */
.tab-content { padding: 20rpx 30rpx; }

.intro-text { font-size: 26rpx; color: #3D2C29; line-height: 1.6; display: block; margin-bottom: 20rpx; }

.intro-tags { display: flex; gap: 12rpx; flex-wrap: wrap; }
.intro-tag {
  font-size: 22rpx; color: #F97316;
  padding: 6rpx 16rpx; border-radius: 20rpx;
  background: rgba(249,115,22,0.08);
}

/* 评论 */
.comment-item {
  display: flex; gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.comment-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; }

.comment-body { flex: 1; }

.comment-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.comment-user { font-size: 24rpx; color: #3D2C29; font-weight: 500; }
.comment-time { font-size: 20rpx; color: #C9957A; }

.comment-text { font-size: 26rpx; color: #3D2C29; line-height: 1.5; display: block; margin-bottom: 8rpx; }

.comment-actions { display: flex; align-items: center; gap: 6rpx; }
.comment-like-icon { width: 24rpx; height: 24rpx; }
.comment-like-count { font-size: 20rpx; color: #C9957A; }

.no-more-comments {
  text-align: center; padding: 30rpx; font-size: 22rpx; color: #C9957A;
}

.loading-view {
  display: flex; align-items: center; justify-content: center;
  height: 80vh; color: #8B7355;
}
