/* ========== 全局容器 ========== */
.screen {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #000;
}

/* ========== 通用状态栏 ========== */
.status-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  padding: 44rpx 32rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.status-time {
  font-size: 24rpx;
  color: #FFF;
  font-weight: 600;
}

.status-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-signal, .status-wifi, .status-battery {
  font-size: 20rpx;
  color: #FFF;
}

.status-bar.dark .status-time,
.status-bar.dark .status-signal,
.status-bar.dark .status-wifi,
.status-bar.dark .status-battery {
  color: #000;
}

/* ========== 壁纸 ========== */
.wallpaper {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(160deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  z-index: 0;
}

.wallpaper-blur {
  background: linear-gradient(160deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  filter: blur(0);
  opacity: 0.85;
}

.home-wallpaper {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(145deg, #667eea 0%, #764ba2 100%);
  z-index: 0;
}

/* ========== 页面切换 ========== */
.lockscreen, .passcode-screen, .homescreen {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
  z-index: 1;
}

.lockscreen.active, .passcode-screen.active, .homescreen.active {
  opacity: 1;
  pointer-events: auto;
  z-index: 5;
}

/* ========== 锁屏 ========== */
.lock-time-area {
  position: absolute;
  top: 220rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 2;
}

.lock-time {
  display: block;
  font-size: 148rpx;
  font-weight: 200;
  color: #FFF;
  letter-spacing: 4rpx;
  line-height: 1;
}

.lock-date {
  display: block;
  font-size: 34rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 16rpx;
  font-weight: 400;
}

.swipe-hint {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}

.swipe-line {
  width: 240rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 4rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ========== 密码页 ========== */
.passcode-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
  height: 100%;
}

.passcode-title {
  font-size: 32rpx;
  color: #FFF;
  margin-bottom: 48rpx;
}

/* 圆点 */
.dots {
  display: flex;
  gap: 36rpx;
  margin-bottom: 80rpx;
}

.dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.7);
  background: transparent;
  transition: background 0.1s;
}

.dot.filled {
  background: #FFF;
  border-color: #FFF;
}

/* 晃动动画 */
.dots.shake {
  animation: shakeAnim 0.5s ease;
}

@keyframes shakeAnim {
  0%, 100% { transform: translateX(0); }
  10%, 50%, 90% { transform: translateX(-16rpx); }
  30%, 70% { transform: translateX(16rpx); }
}

/* 数字键盘 */
.keypad {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.key-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}

.key {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.2);
}

.key:active {
  background: rgba(255,255,255,0.3);
}

.key-empty {
  background: transparent;
  border: none;
}

.key-delete {
  background: transparent;
  border: none;
}

.key-num {
  font-size: 48rpx;
  color: #FFF;
  font-weight: 300;
  line-height: 1.1;
}

.key-sub {
  font-size: 16rpx;
  color: rgba(255,255,255,0.6);
  letter-spacing: 2rpx;
  margin-top: 2rpx;
}

.cancel-btn {
  margin-top: 48rpx;
  padding: 16rpx 40rpx;
}

.cancel-btn text {
  font-size: 30rpx;
  color: rgba(255,255,255,0.7);
}

/* ========== 主屏幕 ========== */
.app-grid {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  padding: 180rpx 48rpx 0;
  gap: 36rpx 0;
  justify-content: space-between;
}

.app-icon {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.icon-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}

.icon-emoji {
  font-size: 48rpx;
}

.icon-label {
  font-size: 22rpx;
  color: #FFF;
  margin-top: 10rpx;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* Dock */
.dock {
  position: absolute;
  bottom: 60rpx;
  left: 48rpx;
  right: 48rpx;
  height: 140rpx;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(20px);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 32rpx;
  z-index: 3;
}

.dock-icon .icon-img {
  width: 100rpx;
  height: 100rpx;
}

.home-indicator {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 240rpx;
  height: 8rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 4rpx;
  z-index: 10;
}
