.post-form-page {
  min-height: 100vh;
  background: #FFF8F3;
  display: flex;
  flex-direction: column;
}

/* ===== 顶部返回栏 ===== */
.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #3D2C29;
}

.form-header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3D2C29;
}

.header-placeholder {
  width: 64rpx;
}

/* ===== 表单滚动区 ===== */
.form-scroll {
  flex: 1;
  height: 0;
}

/* ===== 表单组 ===== */
.form-group {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3D2C29;
  margin-bottom: 16rpx;
  display: block;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #FFF5EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #3D2C29;
}

.picker-arrow {
  font-size: 20rpx;
  color: #C9957A;
}

.form-input {
  height: 80rpx;
  background: #FFF5EB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #3D2C29;
}

.form-textarea {
  width: auto;
  min-height: 300rpx;
  background: #FFF5EB;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #3D2C29;
  line-height: 1.6;
}

/* ===== 底部按钮 ===== */
.form-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx 32rpx;
  background: #fff;
  border-top: 1rpx solid rgba(0,0,0,0.05);
}

.publish-btn {
  background: linear-gradient(135deg, #F97316, #EC4899);
  border-radius: 44rpx;
  padding: 24rpx 0;
  text-align: center;
}

.publish-btn text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 700;
}