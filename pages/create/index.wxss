/* ===== 创作页 ===== */
.create-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(to bottom, #FFF7EE 0%, #FFFBF7 35%, #FFFFFF 100%);
  position: relative;
  box-sizing: border-box;
  /* 底部留白：TabBar(96rpx) + 安全区 + 额外安全余量 */
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ===== 左上角：金币+草稿（微信原生顶部栏区域） ===== */
.top-left-actions {
  position: absolute;
  left: 16rpx;
  height: 88rpx;  /* 和微信右侧胶囊按钮等高 */
  display: flex;
  align-items: center;
  gap: 10rpx;
  z-index: 100;
}

.top-action-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 32rpx;
  background: rgba(139, 115, 85, 0.1);
  height: 52rpx;
  box-sizing: border-box;
  position: relative;
}

.top-action-btn:active {
  background: rgba(139, 115, 85, 0.2);
}

.top-action-icon {
  width: 28rpx;
  height: 28rpx;
}

.top-action-text {
  font-size: 22rpx;
  color: #8B7355;
  font-weight: 600;
}

/* 返回按钮 */
.back-btn {
  padding: 8rpx 20rpx 8rpx 12rpx;
}
.back-arrow {
  font-size: 34rpx;
  color: #8B7355;
  font-weight: bold;
  line-height: 1;
  margin-right: 2rpx;
}

.top-action-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  border-radius: 13rpx;
  background: #F97316;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-action-badge text {
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 大输入框区域 ===== */
.prompt-input-section {
  padding: 16rpx 24rpx 16rpx;
}

.prompt-input-wrap {
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(139, 115, 85, 0.12);
  padding: 28rpx 28rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 44, 41, 0.06);
}

.prompt-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 32rpx;
  color: #3D2C29;
  line-height: 1.5;
}

.prompt-placeholder {
  color: #C9957A;
  font-size: 32rpx;
}

/* 输入框内部下方的工具栏 */
.prompt-tools {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(139, 115, 85, 0.08);
}

.tool-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(139, 115, 85, 0.06);
}

.tool-btn:active {
  background: rgba(139, 115, 85, 0.14);
}

.tool-icon {
  width: 32rpx;
  height: 32rpx;
}

.tool-label {
  font-size: 24rpx;
  color: #8B7355;
}

/* 附件预览 */
.attachment-preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  overflow-x: auto;
}

.attachment-item {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.attachment-thumb {
  width: 100%;
  height: 100%;
}

.attachment-audio {
  width: 100%;
  height: 100%;
  background: #FFF5EB;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.audio-icon {
  font-size: 28rpx;
}

.audio-name {
  font-size: 18rpx;
  color: #8B7355;
  max-width: 70rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attachment-remove {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(61, 44, 41, 0.5);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 生成按钮 */
.generate-btn {
  margin-top: 16rpx;
  background: #E8DDD5;
  border-radius: 44rpx;
  padding: 24rpx 0;
  text-align: center;
  transition: all 0.2s ease;
}

.generate-btn.active {
  background: linear-gradient(135deg, #FDBA74, #F9A8D4);
}

.generate-btn-text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 灵感/共创 Tab ===== */
.create-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 12rpx 0 16rpx;
  background-color: transparent;
}

.create-tab {
  font-size: 32rpx;
  color: #8B7355;
  font-weight: 400;
  padding: 8rpx 0;
  position: relative;
  transition: all 0.2s ease;
}

.create-tab.active {
  color: #F97316;
  font-weight: 700;
  font-size: 34rpx;
}

.create-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(135deg, #F97316, #EC4899);
}

/* ===== 滚动内容区 ===== */
.create-scroll {
  flex: 1;
  height: 0;
  padding: 0 16rpx 20rpx;
}

/* ===== 灵感网格 ===== */
.inspire-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16rpx;
}

.inspire-card {
  position: relative;
  width: 48%;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 41, 0.06);
}

.inspire-bg {
  width: 100%;
  height: 280rpx;
  display: block;
}

.inspire-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to bottom, rgba(61, 44, 41, 0.1) 0%, rgba(61, 44, 41, 0.55) 100%);
}

.inspire-prompt {
  position: absolute;
  bottom: 40rpx;
  left: 16rpx;
  right: 16rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.inspire-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(249, 115, 22, 0.85);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

/* ===== 共创列表 ===== */
.collab-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.collab-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 41, 0.06);
}

.collab-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.collab-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.collab-title {
  font-size: 30rpx;
  color: #3D2C29;
  font-weight: 600;
}

.collab-desc {
  font-size: 24rpx;
  color: #8B7355;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.collab-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.collab-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.collab-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.collab-name {
  font-size: 22rpx;
  color: #8B7355;
}

.collab-btn {
  background: linear-gradient(135deg, #FDBA74, #F9A8D4);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.collab-btn text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 游戏详情模式 ===== */

.game-detail-section {
  padding: 8rpx 8rpx 40rpx;
}

.gd-header {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 41, 0.06);
  margin-bottom: 20rpx;
}

.gd-cover {
  width: 180rpx;
  height: 240rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.gd-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
}

.gd-title {
  font-size: 34rpx;
  color: #3D2C29;
  font-weight: 700;
}

.gd-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.gd-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.gd-author {
  font-size: 22rpx;
  color: #8B7355;
}

.gd-genre {
  font-size: 20rpx;
  color: #F97316;
  background: rgba(249, 115, 22, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 10rpx;
}

.gd-desc {
  font-size: 24rpx;
  color: #8B7355;
  line-height: 1.5;
  margin-top: 6rpx;
}

.gd-block {
  margin-bottom: 20rpx;
}

.gd-block-title {
  font-size: 30rpx;
  color: #3D2C29;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

/* 美术资源 */
.gd-art-list {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
}

.gd-art-item {
  flex-shrink: 0;
  width: 200rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.gd-art-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F5F0EB;
}

.gd-art-name {
  font-size: 22rpx;
  color: #8B7355;
  text-align: center;
}

/* 代码文件 */
.gd-code-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.gd-code-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(61, 44, 41, 0.04);
}

.gd-code-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.gd-code-info {
  flex: 1;
  min-width: 0;
}

.gd-code-name {
  font-size: 26rpx;
  color: #3D2C29;
  font-weight: 600;
  display: block;
}

.gd-code-desc {
  font-size: 22rpx;
  color: #8B7355;
  display: block;
  margin-top: 4rpx;
}

.gd-code-lines {
  font-size: 20rpx;
  color: #C9957A;
  flex-shrink: 0;
}

/* ===== 关卡页面 ===== */
.levels-section {
  padding: 8rpx 8rpx 40rpx;
}

.levels-block {
  margin-bottom: 28rpx;
}

.levels-block-title {
  font-size: 30rpx;
  color: #3D2C29;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.levels-gameplay {
  font-size: 26rpx;
  color: #8B7355;
  line-height: 1.6;
  display: block;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(61, 44, 41, 0.04);
}

.levels-hint {
  font-size: 22rpx;
  color: #C9957A;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  font-style: italic;
}

.levels-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.level-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 1rpx 6rpx rgba(61, 44, 41, 0.04);
}

.level-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #FDBA74, #F9A8D4);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.level-info {
  flex: 1;
  min-width: 0;
}

.level-name {
  font-size: 28rpx;
  color: #3D2C29;
  font-weight: 600;
  display: block;
}

.level-diff {
  font-size: 22rpx;
  color: #C9957A;
  display: block;
  margin-top: 4rpx;
}

.level-creator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.level-creator-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
}

.level-creator-name {
  font-size: 20rpx;
  color: #8B7355;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 共创群聊入口 */
.group-chat-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: rgba(249,115,22,0.06);
  border-radius: 20rpx;
}
.group-chat-left { display: flex; align-items: center; flex: 1; }
.group-chat-icon { width: 48rpx; height: 48rpx; margin-right: 16rpx; }
.group-chat-info { flex: 1; }
.group-chat-title { font-size: 27rpx; font-weight: bold; color: #3D2C29; display: block; }
.group-chat-desc { font-size: 22rpx; color: #8B7355; margin-top: 4rpx; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.group-chat-right { display: flex; align-items: center; gap: 8rpx; }
.group-chat-badge {
  min-width: 32rpx; height: 32rpx;
  background: #F97316; border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
}
.group-chat-badge text { font-size: 20rpx; color: #fff; padding: 0 8rpx; }
.group-chat-arrow { font-size: 36rpx; color: #C9957A; }
