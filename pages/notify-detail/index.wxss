.notify-page { min-height: 100vh; background: linear-gradient(to bottom, #FFF7EE 0%, #FFFBF7 35%, #FFFFFF 100%); }

.notify-header { padding: 16rpx 28rpx 20rpx; display: flex; align-items: center; gap: 20rpx; border-bottom: 1rpx solid rgba(0,0,0,0.05); }
.back-btn { font-size: 28rpx; color: #F97316; font-weight: 500; }
.notify-title { font-size: 34rpx; font-weight: 700; color: #3D2C29; }

.notify-list { padding: 8rpx 0; }
.notify-item { display: flex; padding: 24rpx 28rpx; gap: 20rpx; border-bottom: 1rpx solid rgba(0,0,0,0.04); }
.notify-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0; }
.notify-body { flex: 1; overflow: hidden; }
.notify-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.notify-user { font-size: 26rpx; color: #3D2C29; font-weight: 500; }
.notify-time { font-size: 20rpx; color: #C9957A; }
.notify-action { font-size: 24rpx; color: #8B7355; display: block; margin-bottom: 8rpx; }
.notify-target-wrap { background: rgba(249,115,22,0.06); border-radius: 12rpx; padding: 12rpx 16rpx; border: 1rpx solid rgba(249,115,22,0.1); }
.notify-target { font-size: 24rpx; color: #3D2C29; display: block; }

.notify-empty { text-align: center; padding: 120rpx 0; }
.empty-text { font-size: 28rpx; color: #8B7355; }
