.game-container { width:100vw; height:100vh; position:relative; overflow:hidden; }
.game-canvas { width:100vw; height:100vh; }

/* ===== 和短剧一样的操作栏 ===== */
.side-actions { position:absolute; right:20rpx; bottom:130rpx; display:flex; flex-direction:column; align-items:center; z-index:50; }
.action-item { display:flex; flex-direction:column; align-items:center; margin-bottom:36rpx; }
.action-icon { width:76rpx; height:76rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.25); }
.action-icon-img { width:36rpx; height:36rpx; }
.action-count { font-size:20rpx; color:#FFE8D6; margin-top:6rpx; font-weight:500; }

/* ===== 底部信息 ===== */
.video-info { position:absolute; left:28rpx; right:150rpx; bottom:60rpx; z-index:50; pointer-events:none; }
.info-row { display:flex; align-items:center; gap:12rpx; margin-bottom:10rpx; }
.video-author { font-size:28rpx; color:#fff; font-weight:600; }
.genre-tag { font-size:20rpx; color:#fff; background:rgba(0,0,0,0.3); padding:4rpx 16rpx; border-radius:20rpx; }
.video-title { font-size:32rpx; color:#fff; font-weight:bold; display:block; margin-bottom:6rpx; }
.video-hint { font-size:22rpx; color:rgba(255,255,255,0.7); display:block; }

/* ===== 收起按钮 ===== */
.toggle-btn { position:absolute; right:24rpx; bottom:60rpx; padding:12rpx 24rpx; border-radius:30rpx; background:rgba(0,0,0,0.4); z-index:60; }
.toggle-text { font-size:22rpx; color:#FFE8D6; }
