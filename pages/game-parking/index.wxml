<view class="game-container">
  <canvas type="2d" id="gameCanvas" class="game-canvas"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd">
  </canvas>

  <!-- 右侧操作栏（和短剧一样） -->
  <view class="side-actions" wx:if="{{!uiHidden}}">
    <view class="action-item">
      <view class="action-icon" bindtap="onLikeTap">
        <image class="action-icon-img" wx:if="{{liked}}" src="/assets/icons/heart-filled.png" mode="aspectFit"/>
        <image class="action-icon-img" wx:else src="/assets/icons/heart-outline-warm.png" mode="aspectFit"/>
      </view>
      <text class="action-count">6789</text>
    </view>
    <view class="action-item">
      <view class="action-icon">
        <image class="action-icon-img" src="/assets/icons/comment-warm.png" mode="aspectFit"/>
      </view>
      <text class="action-count">423</text>
    </view>
    <view class="action-item">
      <view class="action-icon">
        <image class="action-icon-img" src="/assets/icons/bookmark-warm.png" mode="aspectFit"/>
      </view>
      <text class="action-count">收藏</text>
    </view>
  </view>

  <!-- 底部信息（和短剧一样） -->
  <view class="video-info" wx:if="{{!uiHidden}}">
    <view class="info-row">
      <text class="video-author">@停车达人</text>
      <text class="genre-tag">策略</text>
    </view>
    <text class="video-title">停车大挑战</text>
    <text class="video-hint">互动游戏 · 同色匹配消除</text>
  </view>

  <!-- 收起/展开按钮 -->
  <view class="toggle-btn" bindtap="onToggleUI">
    <text class="toggle-text">{{uiHidden ? '展开' : '收起'}}</text>
  </view>
</view>
