.game-container { width: 100vw; height: 100vh; background: #0a0a1a; position: relative; overflow: hidden; }
.game-canvas { width: 100vw; height: 100vh; }

.hud {
  position: absolute; top: 0; left: 0; right: 0;
  padding: 100rpx 40rpx 20rpx;
  display: flex; justify-content: space-between; align-items: center;
  pointer-events: none;
}
.level-text { font-size: 30rpx; color: rgba(0,255,200,0.8); font-weight: bold; }
.time-text { font-size: 30rpx; color: rgba(0,255,200,0.6); }

/* ===== 和短剧一样的操作栏 ===== */
.side-actions {
  position: absolute; right: 20rpx; bottom: 130rpx;
  display: flex; flex-direction: column; align-items: center;
  z-index: 50; pointer-events: auto;
}
.action-item { display: flex; flex-direction: column; align-items: center; margin-bottom: 36rpx; }
.action-icon {
  width: 76rpx; height: 76rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.25);
}
.action-icon-img { width: 36rpx; height: 36rpx; }
.action-count { font-size: 20rpx; color: #FFE8D6; margin-top: 6rpx; font-weight: 500; }

/* ===== 和短剧一样的底部信息 ===== */
.video-info { position: absolute; left: 28rpx; right: 150rpx; bottom: 60rpx; z-index: 50; pointer-events: none; }
.info-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 10rpx; }
.video-author { font-size: 28rpx; color: #fff; font-weight: 600; }
.genre-tag { font-size: 20rpx; color: #fff; background: rgba(0,0,0,0.3); padding: 4rpx 16rpx; border-radius: 20rpx; }
.video-title { font-size: 32rpx; color: #fff; font-weight: bold; display: block; margin-bottom: 6rpx; }
.video-hint { font-size: 22rpx; color: rgba(255,255,255,0.7); display: block; }

/* ===== 收起/展开按钮 ===== */
.toggle-btn {
  position: absolute; right: 24rpx; bottom: 60rpx;
  padding: 12rpx 24rpx; border-radius: 30rpx;
  background: rgba(0,0,0,0.4); z-index: 60;
}
.toggle-text { font-size: 22rpx; color: #FFE8D6; }

/* 通关 */
.win-overlay { position: absolute; top:0;left:0;right:0;bottom:0; background:rgba(10,10,26,0.9); display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:100; }
.win-title { font-size:80rpx; color:#00ffc8; font-weight:bold; margin-bottom:30rpx; }
.win-time { font-size:36rpx; color:rgba(0,255,200,0.7); margin-bottom:60rpx; }
.restart-btn { width:360rpx; height:90rpx; border:3rpx solid #00ffc8; border-radius:45rpx; display:flex; align-items:center; justify-content:center; }
.restart-text { font-size:32rpx; color:#00ffc8; letter-spacing:6rpx; }
