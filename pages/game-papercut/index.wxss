.container { display:flex; flex-direction:column; align-items:center; height:100vh; background-color:#F5E6D0; position:relative; overflow:hidden; }
.header { padding-top:calc(env(safe-area-inset-top) + 20rpx); padding-bottom:20rpx; text-align:center; width:100%; position:relative; }
.title { font-size:44rpx; font-weight:bold; color:#8B1A10; }
.subtitle { display:block; font-size:28rpx; color:#A0522D; margin-top:8rpx; }
.main-canvas { width:680rpx; height:680rpx; flex-shrink:0; }
.export-canvas { position:fixed; left:-9999rpx; top:-9999rpx; width:1080px; height:1080px; }
.footer { flex:1; display:flex; flex-direction:column; justify-content:center; align-items:center; width:100%; padding-bottom:calc(env(safe-area-inset-bottom) + 30rpx); }
.hint { font-size:32rpx; color:#A0522D; }
.btn-row { display:flex; gap:24rpx; justify-content:center; flex-wrap:wrap; }
.btn { padding:20rpx 48rpx; border-radius:50rpx; font-size:32rpx; font-weight:600; text-align:center; border:3rpx solid #C4973B; }
.btn.primary { background:#D42A20; color:#FFF; border-color:#C4973B; }
.btn.secondary { background:#FFF8EE; color:#8B1A10; border-color:#C4973B; }
.btn:active { opacity:0.7; }
.toast { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); background:rgba(0,0,0,0.72); color:#FFF; padding:20rpx 40rpx; border-radius:16rpx; font-size:28rpx; opacity:0; pointer-events:none; transition:opacity 0.3s; z-index:100; }
.toast.show { opacity:1; }

/* ===== 和短剧一样的操作栏 ===== */
.side-actions { position:absolute; right:20rpx; bottom:130rpx; display:flex; flex-direction:column; align-items:center; z-index:50; }
.action-item { display:flex; flex-direction:column; align-items:center; margin-bottom:36rpx; }
.action-icon { width:76rpx; height:76rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.15); }
.action-icon-img { width:36rpx; height:36rpx; }
.action-count { font-size:20rpx; color:#8B1A10; margin-top:6rpx; font-weight:500; }

/* ===== 底部信息 ===== */
.video-info { position:absolute; left:28rpx; right:150rpx; bottom:60rpx; z-index:50; pointer-events:none; }
.info-row { display:flex; align-items:center; gap:12rpx; margin-bottom:10rpx; }
.video-author { font-size:28rpx; color:#8B1A10; font-weight:600; }
.genre-tag { font-size:20rpx; color:#8B1A10; background:rgba(139,26,16,0.1); padding:4rpx 16rpx; border-radius:20rpx; }
.video-title { font-size:32rpx; color:#8B1A10; font-weight:bold; display:block; margin-bottom:6rpx; }
.video-hint { font-size:22rpx; color:#A0522D; display:block; }

/* ===== 收起按钮 ===== */
.toggle-btn { position:absolute; right:24rpx; bottom:60rpx; padding:12rpx 24rpx; border-radius:30rpx; background:rgba(139,26,16,0.2); z-index:60; }
.toggle-text { font-size:22rpx; color:#8B1A10; }
