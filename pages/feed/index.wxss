/* ===== 小红书风格信息流页面 - 暖色调 ===== */
.feed-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(to bottom, #FFF7EE 0%, #FFFBF7 35%, #FFFFFF 100%);
}

.feed-swiper {
  flex: 1;
  height: auto;
}

.feed-scroll-item {
  height: 100%;
  box-sizing: border-box;
}

/* ===== 一级 Tab：短剧 / 游戏 ===== */
.top-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 12rpx 0 16rpx;
  background-color: transparent;
}

.top-tab {
  font-size: 32rpx;
  color: #8B7355;
  font-weight: 400;
  padding: 8rpx 0;
  position: relative;
  transition: all 0.2s ease;
}

.top-tab.active {
  color: #F97316;
  font-weight: 700;
  font-size: 34rpx;
}

.top-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(135deg, #F97316, #EC4899);
}

.top-tab:active {
  opacity: 0.7;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: transparent;
}

.search-input-wrap {
  flex: 1;
  height: 64rpx;
  background-color: #FFF5EB;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border: 2rpx solid rgba(249,115,22,0.12);
}

.search-input-wrap:focus-within {
  border-color: rgba(249,115,22,0.35);
  box-shadow: 0 0 0 4rpx rgba(249,115,22,0.08);
}

.search-icon {
  margin-right: 12rpx;
  display: flex;
  align-items: center;
}

.search-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  font-size: 26rpx;
  color: #3D2C29;
}

.clear-btn {
  margin-left: 16rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #F97316;
  background: none;
  border: none;
}

/* ===== 分类 Tab 栏 ===== */
.category-tabs {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background-color: transparent;
  gap: 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}

.category-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #8B7355;
  padding: 10rpx 0 18rpx;
  position: relative;
  transition: all 0.2s ease;
  font-weight: 400;
}

.category-tab.active {
  color: #F97316;
  font-weight: 700;
}

.category-tab.active::after {
  content: '';
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(135deg, #F97316, #EC4899);
}

.category-tab:active {
  opacity: 0.7;
}

/* ===== 瀑布流滚动区域 ===== */
.feed-scroll {
  padding: 16rpx 0 calc(20rpx + 160rpx);
}

.waterfall-container {
  display: flex;
  justify-content: space-between;
  padding: 16rpx;
}

.waterfall-column {
  width: 48%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 帖子卡片 */
.post-card {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61,44,41,0.06);
}

.post-cover-wrap {
  position: relative;
  width: 100%;
  padding-top: 133.33%;  /* 3:4 比例 = 4/3 * 100% */
  overflow: hidden;
}

.post-cover {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 20rpx 20rpx 0 0;
}

.play-icon-overlay {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.25);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-triangle {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 16rpx 0 16rpx 26rpx;
  border-color: transparent transparent transparent #fff;
  margin-left: 6rpx;
}

.post-info {
  padding: 16rpx;
}

.post-title {
  font-size: 26rpx;
  color: #3D2C29;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.post-author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-author {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.post-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(249,115,22,0.2);
}

.post-name {
  font-size: 22rpx;
  color: #8B7355;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-like-count {
  font-size: 22rpx;
  color: #F43F5E;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.like-icon-sm {
  width: 24rpx;
  height: 24rpx;
}

.loading-tip {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #8B7355;
}

/* ===== 游戏卡片 ===== */
.game-card {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 41, 0.06);
}

.game-cover-wrap {
  position: relative;
  width: 100%;
  padding-top: 133.33%;
  overflow: hidden;
}

.game-cover {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 20rpx 20rpx 0 0;
}

.game-cover-badge {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}

.game-badge-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 论坛卡片 ===== */
.forum-card {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 41, 0.06);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 论坛封面图 */
.forum-cover-wrap {
  position: relative;
  width: 100%;
  padding-top: 60%;
  border-radius: 16rpx;
  overflow: hidden;
}

.forum-cover {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.forum-category-pill {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  align-self: flex-start;
}

.forum-card-title {
  font-size: 28rpx;
  color: #3D2C29;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.forum-card-content {
  font-size: 24rpx;
  color: #8B7355;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.forum-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.forum-card-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.forum-card-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.forum-card-name {
  font-size: 20rpx;
  color: #8B7355;
}

.forum-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.forum-card-time {
  font-size: 20rpx;
  color: #C9957A;
}

.forum-card-comments {
  font-size: 20rpx;
  color: #F97316;
}

/* ===== 悬赏卡片 ===== */
.bounty-card {
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 41, 0.06);
  display: flex;
  flex-direction: column;
}

/* 悬赏封面图 */
.bounty-cover-wrap {
  position: relative;
  width: 100%;
  padding-top: 60%;
  overflow: hidden;
}

.bounty-cover {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.bounty-budget-bar {
  background: #FFF5EB;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid rgba(201, 149, 122, 0.15);
}

.bounty-budget-text {
  font-size: 30rpx;
  color: #8B7355;
  font-weight: 700;
}

.bounty-card-title {
  font-size: 28rpx;
  color: #3D2C29;
  font-weight: 600;
  line-height: 1.4;
  padding: 16rpx 20rpx 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bounty-card-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 20rpx;
}

.bounty-type-tag {
  font-size: 20rpx;
  color: #8B7355;
  background: rgba(139, 115, 85, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.bounty-deadline {
  font-size: 20rpx;
  color: #C9957A;
}

.bounty-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx 20rpx;
  margin-top: 4rpx;
}

.bounty-card-author {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.bounty-card-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}

.bounty-card-name {
  font-size: 20rpx;
  color: #8B7355;
}

.bounty-card-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bounty-submissions {
  font-size: 20rpx;
  color: #8B7355;
}

.bounty-status {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.bounty-status.open {
  color: #8B7355;
  background: rgba(139, 115, 85, 0.1);
}

.bounty-status.claimed {
  color: #C9957A;
  background: rgba(201, 149, 122, 0.1);
}

.bounty-status.submitted {
  color: #8B7355;
  background: rgba(139, 115, 85, 0.1);
}

.bounty-status.completed {
  color: #8B7355;
  background: rgba(139, 115, 85, 0.1);
}

.bounty-status.expired {
  color: #C9957A;
  background: rgba(201, 149, 122, 0.1);
}

/* ===== 自荐气泡 ===== */
.self-rec-bubble {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  max-width: 80%;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
}
.self-rec-bubble text {
  font-size: 20rpx;
  color: #fff;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}
