/* ===== AI互动视频页面 - 暖色调设计规范 ===== */

/* === 页面容器 === */
.page-container { height: 100vh; width: 100vw; position: relative; background-color: #0a0a1a; overflow: hidden; }
.video-swiper { width: 100%; height: 100%; }
.swiper-item { width: 100%; height: 100%; position: relative; overflow: hidden; }

/* === 统一布局：上方内容 + 下方UI === */
/* padding-bottom 确保所有内容（含底部UI栏）在悬浮TabBar上方 */
.item-layout { width: 100%; height: 100%; display: flex; flex-direction: column; position: relative; padding-bottom: 180rpx; box-sizing: border-box; }
.content-area { flex: 1; position: relative; overflow: hidden; background: #0a0a1a; }
.content-fill { width: 100%; height: 100%; display: block; }

/* 游戏顶部功能栏（和底部UI同风格的独立横条） */
.game-top-ui {
  width: 100%;
  padding: 12rpx 24rpx;
  background: #111;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.top-ui-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.top-ui-icon {
  width: 28rpx;
  height: 28rpx;
}

.top-ui-text {
  font-size: 22rpx;
  color: #FFE8D6;
  font-weight: 500;
}

/* === 底部统一UI栏 === */
.bottom-ui {
  width: 100%;
  padding: 14rpx 24rpx;
  padding-bottom: 12rpx;
  background: #111;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bottom-info { display: flex; flex-direction: column; gap: 2rpx; flex: 1; overflow: hidden; }
.bottom-author { font-size: 22rpx; color: #C9957A; font-weight: 500; }
.bottom-title { font-size: 26rpx; color: #fff; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bottom-actions { display: flex; align-items: center; gap: 28rpx; flex-shrink: 0; }
.bot-act { display: flex; flex-direction: column; align-items: center; gap: 2rpx; }
.bot-act-img { width: 32rpx; height: 32rpx; }
.bot-act-num { font-size: 18rpx; color: #FFE8D6; }

/* 提意见弹窗 */
.feedback-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 500;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-panel {
  width: 88%;
  background: #FFF8F3;
  border-radius: 28rpx;
  padding: 32rpx;
  animation: panelSlideUp 0.3s ease;
  box-shadow: 0 8rpx 40rpx rgba(0,0,0,0.15);
}

.feedback-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.feedback-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D2C29;
}

.feedback-close {
  font-size: 36rpx;
  color: #8B7355;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: rgba(0,0,0,0.04);
}

.feedback-types {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.fb-type {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #8B7355;
  background: #F5F0EB;
  transition: all 0.2s;
}

.fb-type.active {
  background: linear-gradient(135deg, #FDBA74, #F9A8D4);
  color: #fff;
}

.feedback-textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid rgba(139,115,85,0.15);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #3D2C29;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.feedback-submit {
  background: linear-gradient(135deg, #FDBA74, #F9A8D4);
  border-radius: 44rpx;
  padding: 22rpx 0;
  text-align: center;
}

.feedback-submit text {
  font-size: 30rpx;
  color: #fff;
  font-weight: 600;
}

/* 展开按钮 — 悬浮TabBar上方 */
.expand-btn { position: absolute; right: 20rpx; bottom: 340rpx; padding: 10rpx 20rpx; border-radius: 24rpx; background: rgba(255,255,255,0.12); z-index: 50; }
.expand-text { font-size: 20rpx; color: #FFE8D6; }

/* 加载提示 */
.loading-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  z-index: 30;
  pointer-events: none;
}
.loading-text {
  color: rgba(255,255,255,0.6);
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 30rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

/* 暂停图标 */
.pause-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex; align-items: center; justify-content: center;
  z-index: 35;
}

.pause-icon-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.35);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.pause-bar {
  width: 10rpx;
  height: 36rpx;
  background: #fff;
  border-radius: 4rpx;
}

/* === 自定义进度条 — 悬浮TabBar上方边缘 === */
.progress-bar-wrap {
  position: fixed;
  left: 0; right: 0;
  bottom: 262rpx;
  z-index: 1000;
  padding: 20rpx 32rpx 16rpx;
  display: flex;
  align-items: center;
}

.progress-bar-bg {
  width: 100%;
  height: 6rpx;
  background: rgba(255,255,255,0.25);
  position: relative;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(to right, #F97316, #EC4899);
  border-radius: 0 3rpx 3rpx 0;
  position: relative;
}

.progress-bar-fill::after {
  content: '';
  position: absolute;
  right: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 8rpx rgba(0,0,0,0.3);
}

/* === 顶部操作栏 — 避开状态栏 === */
.top-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  z-index: 60;
  padding: 20rpx 28rpx;
  /* 关键：用 padding-top 避开手机状态栏 */
  padding-top: calc(env(safe-area-inset-top) + 88rpx);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  pointer-events: none;
}

.ending-label {
  font-size: 26rpx;
  color: #fff;
  font-weight: bold;
  letter-spacing: 1rpx;
  line-height: 1.5;
  display: block;
  pointer-events: none;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  align-self: flex-start;
}

.top-actions {
  display: flex;
  gap: 16rpx;
  pointer-events: auto;
}

.top-btn {
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  color: #FFE8D6;
  background: rgba(0,0,0,0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-weight: 500;
  transition: all 150ms ease;
}

.top-btn:active {
  transform: scale(0.95);
  background: rgba(0,0,0,0.4);
}

.btn-icon {
  width: 28rpx;
  height: 28rpx;
}

/* === 右侧操作栏 — 悬浮TabBar上方（留足安全距离）=== */
.side-actions {
  position: absolute;
  right: 20rpx;
  bottom: 340rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 50;
  pointer-events: auto;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
  position: relative;
}

.action-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: none;
  transition: all 150ms ease;
}

.action-icon:active {
  transform: scale(0.9);
  background: rgba(0,0,0,0.4);
}

.action-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.action-count {
  font-size: 20rpx;
  color: #FFE8D6;
  margin-top: 6rpx;
  font-weight: 500;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.5);
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}

.add-follow-btn {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F97316, #EC4899);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  bottom: -14rpx;
  right: 0;
  box-shadow: 0 2rpx 8rpx rgba(249,115,22,0.4);
  font-weight: bold;
}

/* === 底部信息区 — 悬浮TabBar上方 === */
.video-info {
  position: absolute;
  left: 28rpx;
  right: 150rpx;
  bottom: 340rpx;
  z-index: 50;
  pointer-events: none;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.video-author {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.6);
}

.genre-tag {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.video-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  line-height: 1.4;
  display: block;
  margin-bottom: 6rpx;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.6);
}

.video-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  display: block;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.5);
}

/* === 选项面板 — 暖色统一卡片 === */
.choice-panel {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 480rpx;
  animation: fadeIn 0.3s ease;
  background: linear-gradient(
    to bottom,
    transparent 25%,
    rgba(255,248,243,0.6) 55%,
    rgba(255,248,243,0.95) 80%,
    rgba(255,248,243,0.99) 100%
  );
}

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

.choice-hint {
  font-size: 28rpx;
  color: #8B7355;
  font-weight: 500;
  margin-bottom: 40rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.choice-list {
  width: 84%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.choice-card {
  width: 100%;
  padding: 36rpx 36rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(249,115,22,0.18);
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
  animation: slideUp 0.35s cubic-bezier(0.16,1,0.3,1) both;
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: all 150ms ease;
}

.choice-card:active {
  transform: scale(0.97);
  border-color: #F97316;
  box-shadow: 0 8rpx 32rpx rgba(249,115,22,0.15);
}

.choice-card-0 { animation-delay: 0s; }
.choice-card-1 { animation-delay: 0.08s; }
.choice-card-2 { animation-delay: 0.16s; }

@keyframes slideUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.choice-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F97316, #EC4899);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.choice-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D2C29;
  letter-spacing: 1rpx;
  flex: 1;
}

/* === 黑屏结局 === */
.black-screen {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 40;
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  animation: fadeIn 0.8s ease;
}

.black-screen-text {
  font-size: 36rpx;
  color: #fff;
  text-align: center;
  line-height: 1.6;
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* === 隐藏线索按钮 === */
.clue-cover-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}

.clue-btn {
  position: absolute;
  width: 120rpx; height: 120rpx;
  margin-left: -60rpx; margin-top: -60rpx;
  display: flex; align-items: center; justify-content: center;
  pointer-events: auto;
  animation: clueBlink 1.5s ease-in-out infinite;
}

.clue-btn-icon { font-size: 56rpx; line-height: 1.2; }

.clue-btn-ring {
  position: absolute;
  top: -16rpx; left: -16rpx; right: -16rpx; bottom: -16rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(249,115,22,0.5);
  animation: clueRingPulse 1.8s ease-out infinite;
  box-shadow: 0 0 16rpx rgba(249,115,22,0.2);
}

@keyframes clueBlink {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.92); }
}
@keyframes clueRingPulse {
  0% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.6); }
}

/* === 故事支线面板 === */
.tree-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 300;
  display: flex; align-items: center; justify-content: center;
}

.tree-backdrop {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255,248,243,0.88);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.tree-content {
  position: relative;
  width: 86%; max-height: 78vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  animation: treeSlideUp 0.35s cubic-bezier(0.16,1,0.3,1) both;
  display: flex; flex-direction: column;
  border: 1.5rpx solid rgba(249,115,22,0.2);
  box-shadow: 0 24rpx 60rpx rgba(0,0,0,0.12);
}

@keyframes treeSlideUp {
  from { opacity: 0; transform: translateY(60rpx) scale(0.95); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.tree-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(249,115,22,0.1);
}

.tree-title {
  font-size: 34rpx; font-weight: bold;
  color: #F97316;
  display: flex; align-items: center; gap: 8rpx;
}

.tree-title-icon {
  width: 36rpx; height: 36rpx;
}

.tree-close {
  font-size: 36rpx;
  color: #8B7355;
  padding: 8rpx 12rpx;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: rgba(0,0,0,0.04);
  transition: all 150ms ease;
}
.tree-close:active { background: rgba(249,115,22,0.1); color: #F97316; }

.tree-story-name {
  font-size: 26rpx;
  color: #8B7355;
  padding: 12rpx 32rpx 8rpx;
  display: block;
}

/* 树状图 */
.tree-canvas {
  padding: 30rpx 20rpx;
  display: flex; flex-direction: column; align-items: center;
}

.t-node { display: flex; align-items: center; gap: 14rpx; }
.t-root { justify-content: center; }
.t-dot { width: 44rpx; height: 44rpx; border-radius: 50%; flex-shrink: 0; }
.t-dot-gold {
  background: linear-gradient(135deg, #F97316, #EC4899);
  box-shadow: 0 0 20rpx rgba(249,115,22,0.3);
}
.t-label { font-size: 28rpx; color: #F97316; font-weight: bold; }

.t-vline {
  width: 3rpx; height: 40rpx;
  background: linear-gradient(to bottom, rgba(249,115,22,0.4), rgba(249,115,22,0.15));
  margin-left: calc(22rpx - 1.5rpx);
}

.t-fork { position: relative; width: 500rpx; height: 3rpx; display: flex; justify-content: center; }
.t-fork-h {
  position: absolute; top: 0; left: 50%;
  width: 300rpx; height: 3rpx;
  background: linear-gradient(to right, rgba(249,115,22,0.1), rgba(236,72,153,0.3), rgba(249,115,22,0.1));
  transform: translateX(-50%);
}
.t-fork-left-line, .t-fork-right-line {
  position: absolute; top: 0;
  width: 3rpx; height: 36rpx;
  background: linear-gradient(to bottom, rgba(236,72,153,0.25), rgba(249,115,22,0.08));
}
.t-fork-left-line { left: 100rpx; }
.t-fork-right-line { right: 100rpx; }

.t-branch-col-area { display: flex; justify-content: space-between; width: 500rpx; margin-top: -2rpx; }
.t-branch-side { display: flex; flex-direction: column; align-items: center; width: 220rpx; }
.t-left {} .t-right {}
.t-vline-short {
  width: 3rpx; height: 28rpx;
  background: linear-gradient(to bottom, rgba(249,115,22,0.1), rgba(249,115,22,0.04));
}

.t-option-card {
  width: 100%; padding: 20rpx 18rpx;
  border-radius: 16rpx; display: flex; flex-direction: column; gap: 8rpx; min-height: 120rpx;
  transition: all 150ms ease;
}

.opt-unlocked { background: rgba(249,115,22,0.06); border: 1.5rpx solid rgba(249,115,22,0.25); }
.opt-unlocked:active { background: rgba(249,115,22,0.12); }
.opt-locked { background: rgba(0,0,0,0.02); border: 1.5rpx dashed rgba(0,0,0,0.1); }

.opt-tag { font-size: 36rpx; font-weight: bold; align-self: flex-start; line-height: 1; }
.opt-unlocked .opt-tag { color: #F97316; }
.opt-locked .opt-tag { color: rgba(0,0,0,0.15); }

.opt-name {
  font-size: 24rpx; color: #3D2C29; font-weight: 600; display: block;
  line-height: 1.35; overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.opt-result { font-size: 21rpx; color: #8B7355; display: block; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.opt-hidden { color: rgba(0,0,0,0.15) !important; font-style: italic; }

.tree-progress {
  padding: 20rpx 32rpx;
  border-top: 1rpx solid rgba(249,115,22,0.08);
  text-align: center;
}
.progress-text { font-size: 24rpx; color: #8B7355; }

.clue-progress {
  margin-top: 20rpx; padding: 20rpx;
  background: rgba(249,115,22,0.04); border-radius: 16rpx;
  border: 1rpx solid rgba(249,115,22,0.1);
}
.clue-label { font-size: 24rpx; font-weight: 600; color: #F97316; display: block; margin-bottom: 14rpx; }

.clue-dots-row { display: flex; justify-content: center; gap: 30rpx; margin-bottom: 12rpx; }
.clue-dot-wrap { display: flex; flex-direction: column; align-items: center; gap: 6rpx; }

.c-dot {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(0,0,0,0.03); border: 2rpx dashed rgba(0,0,0,0.1);
  display: flex; align-items: center; justify-content: center;
}
.c-dot.found {
  background: linear-gradient(135deg, rgba(249,115,22,0.12), rgba(236,72,153,0.08));
  border-style: solid; border-color: rgba(249,115,22,0.35);
  box-shadow: 0 0 16rpx rgba(249,115,22,0.15);
}
.c-dot-icon { font-size: 28rpx; line-height: 1; }
.c-dot-name { font-size: 18rpx; color: #8B7355; max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: center; }
.clue-count-hint { font-size: 22rpx; color: #F97316; display: block; text-align: center; font-weight: 500; }

/* === 评论弹窗 === */
.comment-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 500;
  display: flex;
  align-items: flex-end;
}

.comment-panel {
  width: 100%;
  height: 65vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: panelSlideUp 0.3s ease;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.15);
}

@keyframes panelSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.comment-panel-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
  flex-shrink: 0;
}

.comment-panel-title { font-size: 30rpx; font-weight: 600; color: #3D2C29; }

.comment-panel-close {
  font-size: 36rpx; color: #8B7355;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: rgba(0,0,0,0.04);
}

.comment-panel-scroll { flex: 1; height: 0; padding: 0 32rpx; }

.cp-comment-item {
  display: flex; gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}

.cp-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; }
.cp-body { flex: 1; }
.cp-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6rpx; }
.cp-user { font-size: 24rpx; color: #3D2C29; font-weight: 500; }
.cp-time { font-size: 20rpx; color: #C9957A; }
.cp-text { font-size: 26rpx; color: #3D2C29; line-height: 1.5; display: block; margin-bottom: 8rpx; }
.cp-actions { display: flex; align-items: center; gap: 6rpx; }
.cp-like-icon { width: 24rpx; height: 24rpx; }
.cp-like-count { font-size: 20rpx; color: #C9957A; }
.cp-no-more { text-align: center; padding: 30rpx; font-size: 22rpx; color: #C9957A; }

/* ===== 游戏按钮 — 悬浮TabBar上方 ===== */
.game-action-bar {
  position: absolute;
  bottom: 80rpx;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.game-btn { padding: 12rpx 32rpx; border-radius: 40rpx; background: #F97316; color: #fff; font-size: 24rpx; font-weight: 600; }
.game-btn-sm { padding: 10rpx 20rpx; border-radius: 30rpx; background: rgba(255,255,255,0.2); color: #fff; font-size: 22rpx; }

/* ===== 锁屏游戏内嵌 ===== */
.ls-content { position: relative; overflow: hidden; background: #000; }

.ls-wallpaper {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(160deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  z-index: 0;
}
.ls-wallpaper-home {
  background: linear-gradient(145deg, #667eea 0%, #764ba2 100%);
}
.ls-wallpaper-blur {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(160deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
  opacity: 0.85;
  z-index: 0;
}

.ls-status-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 88rpx;
  padding: 44rpx 32rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}
.ls-st { font-size: 24rpx; color: #FFF; font-weight: 600; }
.ls-sr { display: flex; align-items: center; gap: 8rpx; }
.ls-sig, .ls-wf, .ls-bat { font-size: 20rpx; color: #FFF; }
.ls-status-bar.dark .ls-st,
.ls-status-bar.dark .ls-sig,
.ls-status-bar.dark .ls-wf,
.ls-status-bar.dark .ls-bat { color: #000; }

.ls-page {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
  z-index: 1;
}
.ls-page.ls-active { opacity: 1; pointer-events: auto; z-index: 5; }

/* 锁屏页 */
.ls-time-wrap {
  position: absolute;
  top: 220rpx;
  left: 0; right: 0;
  text-align: center;
  z-index: 2;
}
.ls-big-time {
  display: block;
  font-size: 148rpx;
  font-weight: 200;
  color: #FFF;
  letter-spacing: 4rpx;
  line-height: 1;
}
.ls-big-date {
  display: block;
  font-size: 34rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 16rpx;
  font-weight: 400;
}
.ls-swipe {
  position: absolute;
  bottom: 340rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}
.ls-swipe-line {
  width: 240rpx;
  height: 8rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 4rpx;
  animation: lsPulse 2s infinite;
}
@keyframes lsPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 密码页 */
.ls-pc-box {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
  height: 100%;
}
.ls-pc-title {
  font-size: 32rpx;
  color: #FFF;
  margin-bottom: 48rpx;
}
.ls-dots {
  display: flex;
  gap: 36rpx;
  margin-bottom: 80rpx;
}
.ls-dot {
  width: 24rpx; height: 24rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255,255,255,0.7);
  background: transparent;
  transition: background 0.1s;
}
.ls-dot.ls-filled {
  background: #FFF;
  border-color: #FFF;
}
.ls-dots.ls-shake { animation: lsShake 0.5s ease; }
@keyframes lsShake {
  0%, 100% { transform: translateX(0); }
  10%, 50%, 90% { transform: translateX(-16rpx); }
  30%, 70% { transform: translateX(16rpx); }
}

.ls-keypad {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.ls-krow {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}
.ls-key {
  width: 140rpx; height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.2);
}
.ls-key:active { background: rgba(255,255,255,0.3); }
.ls-key-empty { background: transparent; border: none; }
.ls-key-del { background: transparent; border: none; }
.ls-kn { font-size: 48rpx; color: #FFF; font-weight: 300; line-height: 1.1; }
.ls-ks { font-size: 16rpx; color: rgba(255,255,255,0.6); letter-spacing: 2rpx; margin-top: 2rpx; }

.ls-cancel {
  margin-top: 48rpx;
  padding: 16rpx 40rpx;
}
.ls-cancel text { font-size: 30rpx; color: rgba(255,255,255,0.7); }

/* 主屏幕 */
.ls-grid {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  padding: 180rpx 48rpx 0;
  gap: 36rpx 0;
  justify-content: space-between;
}
.ls-app {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.ls-app-icon {
  width: 112rpx; height: 112rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}
.ls-app-emoji { font-size: 48rpx; }
.ls-app-name {
  font-size: 22rpx;
  color: #FFF;
  margin-top: 10rpx;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ls-dock {
  position: absolute;
  bottom: 340rpx;
  left: 48rpx; right: 48rpx;
  height: 140rpx;
  background: rgba(255,255,255,0.2);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 32rpx;
  z-index: 3;
}
.ls-dock-item .ls-app-icon { width: 100rpx; height: 100rpx; }

.ls-indicator {
  position: absolute;
  bottom: 340rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 240rpx;
  height: 8rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 4rpx;
  z-index: 10;
}

/* ===== 排行榜弹窗（居中浮层，暖色系） ===== */
.rank-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.rank-panel {
  width: 90%;
  max-height: 75vh;
  background: #FFF8F3;
  border-radius: 32rpx;
  padding: 36rpx 28rpx 32rpx;
}
.rank-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.rank-title { font-size: 34rpx; font-weight: bold; color: #3D2C29; }
.rank-close { font-size: 36rpx; color: #8B7355; padding: 12rpx; }

/* 领奖台 */
.rank-podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(249,115,22,0.15);
  margin-bottom: 12rpx;
}
.podium-item { display: flex; flex-direction: column; align-items: center; width: 130rpx; }
.podium-1 { order: 2; }
.podium-2 { order: 1; }
.podium-3 { order: 3; }
.podium-avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  border: 4rpx solid #F97316;
  margin-bottom: 8rpx;
}
.podium-2 .podium-avatar { border-color: #C9957A; }
.podium-3 .podium-avatar { border-color: #EC4899; }
.podium-name { font-size: 20rpx; color: #3D2C29; margin-bottom: 4rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 130rpx; text-align: center; }
.podcast-score, .podium-score { font-size: 24rpx; font-weight: bold; color: #F97316; }
.podium-2 .podium-score { color: #C9957A; }
.podium-3 .podium-score { color: #EC4899; }
.podium-tag { font-size: 28rpx; line-height: 1; }

/* 排行列表 */
.rank-list-scroll { max-height: 400rpx; }
.rank-item {
  display: flex; align-items: center; padding: 14rpx 10rpx;
  border-bottom: 1rpx solid rgba(61,44,41,0.05);
}
.rank-num {
  width: 44rpx; font-size: 26rpx; font-weight: bold;
  color: #C9957A; text-align: center;
}
.rank-avatar { width: 52rpx; height: 52rpx; border-radius: 50%; margin-right: 14rpx; }
.rank-name { flex: 1; font-size: 25rpx; color: #3D2C29; }
.rank-score { font-size: 25rpx; font-weight: bold; color: #F97316; }

/* ===== 成就弹窗（居中浮层，暖色系） ===== */
.achieve-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.achieve-panel {
  width: 85%;
  max-height: 72vh;
  background: #FFF8F3;
  border-radius: 32rpx;
  padding: 32rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
}
.achieve-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 18rpx;
}
.achieve-title { font-size: 34rpx; font-weight: bold; color: #3D2C29; }
.achieve-close { font-size: 36rpx; color: #8B7355; padding: 12rpx; }

.achieve-list-scroll { flex: 1; max-height: 520rpx; overflow-y: auto; }
.achieve-item {
  display: flex; align-items: center; padding: 16rpx 10rpx;
  border-bottom: 1rpx solid rgba(61,44,41,0.05);
}
.achieve-item.locked { opacity: 0.45; }
.achieve-icon { font-size: 40rpx; width: 56rpx; text-align: center; margin-right: 14rpx; }
.achieve-icon.gray { filter: grayscale(1); opacity: 0.45; }
.achieve-info { flex: 1; }
.achieve-name { font-size: 27rpx; font-weight: bold; color: #3D2C29; display: block; }
.achieve-name.gray { color: #C9957A; }
.achieve-desc { font-size: 21rpx; color: #8B7355; display: block; margin-top: 4rpx; }
.achieve-status { font-size: 28rpx; }
.achieve-footer {
  text-align: center; padding-top: 16rpx;
  border-top: 1rpx solid rgba(249,115,22,0.12);
  font-size: 23rpx; color: #8B7355;
}
