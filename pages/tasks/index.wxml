<view class="tasks-page">
  <!-- 顶部金币卡 -->
  <view class="coin-card">
    <view class="coin-card-left">
      <text class="coin-big-icon">🪙</text>
      <view class="coin-info">
        <text class="coin-amount">{{coins}}</text>
        <text class="coin-desc">1 金币 = 1 Token</text>
      </view>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="task-list">
    <view class="task-card {{item.done?'done':''}}" wx:for="{{tasks}}" wx:key="id">
      <view class="task-left">
        <text class="task-title">{{item.title}}</text>
        <text class="task-desc">{{item.desc}}</text>
        <view class="task-progress-bar">
          <view class="task-progress-fill" style="width: {{item.progress / item.total * 100}}%"></view>
        </view>
        <text class="task-progress-text">{{item.progress}}/{{item.total}}</text>
      </view>
      <view class="task-right">
        <view class="task-reward">
          <text class="task-reward-icon">🪙</text>
          <text class="task-reward-num">+{{item.reward}}</text>
        </view>
        <view class="task-btn {{item.done?'claimed':''}}" data-id="{{item.id}}" bindtap="onClaimTask">
          <text wx:if="{{item.done}}">已领取</text>
          <text wx:elif="{{item.progress >= item.total}}">领取</text>
          <text wx:else>去完成</text>
        </view>
      </view>
    </view>
  </view>
</view>
