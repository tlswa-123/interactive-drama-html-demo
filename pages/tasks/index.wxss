.tasks-page {
  min-height: 100vh;
  background: #FFF8F3;
  padding: 20rpx 24rpx;
}

/* 金币卡 */
.coin-card {
  background: linear-gradient(135deg, #FDBA74, #F9A8D4);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.coin-card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coin-big-icon {
  font-size: 56rpx;
}

.coin-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.coin-amount {
  font-size: 48rpx;
  color: #fff;
  font-weight: 700;
}

.coin-desc {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

/* 任务列表 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 41, 0.06);
}

.task-card.done {
  opacity: 0.6;
}

.task-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.task-title {
  font-size: 28rpx;
  color: #3D2C29;
  font-weight: 600;
}

.task-desc {
  font-size: 22rpx;
  color: #8B7355;
}

.task-progress-bar {
  width: 200rpx;
  height: 8rpx;
  background: #F5F0EB;
  border-radius: 4rpx;
  margin-top: 6rpx;
  overflow: hidden;
}

.task-progress-fill {
  height: 100%;
  background: linear-gradient(to right, #F97316, #EC4899);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.task-progress-text {
  font-size: 20rpx;
  color: #C9957A;
}

.task-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.task-reward {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.task-reward-icon {
  font-size: 24rpx;
}

.task-reward-num {
  font-size: 26rpx;
  color: #F97316;
  font-weight: 700;
}

.task-btn {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FDBA74, #F9A8D4);
}

.task-btn text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

.task-btn.claimed {
  background: #E8E8E8;
}

.task-btn.claimed text {
  color: #999;
}
